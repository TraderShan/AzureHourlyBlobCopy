{
  "version": "2.0",
  "functionTimeout": "00:58:00",
  "logging": {
    "logLevel": {
      "default": "Warning",
      "Worker": "Information",
      "Function": "Information",
      "Host.Results": "Information"
    },
    "applicationInsights": {"samplingSettings": {"isEnabled": false}}
  },
  "extensions": {
    "durableTask": {
      "hubName": "%COPY_TASK_HUB%",
      "maxConcurrentActivityFunctions": 1,
      "tracing": {"traceInputsAndOutputs": false}
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  }
}
